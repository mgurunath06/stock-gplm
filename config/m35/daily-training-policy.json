{
  "contract": "stock-gplm.m35-daily-training-policy.v1",
  "horizons": ["1-7d", "7-15d", "15-30d"],
  "target": "GROSS_RETURN_AT_MAX_OFFSET_ABOVE_SAME_DATE_ELIGIBLE_MEDIAN",
  "universe": {
    "minimum_observations": 252,
    "turnover_window_observations": 20,
    "minimum_median_turnover_inr": 50000000,
    "minimum_close_inr": 20,
    "minimum_volatility_20": 0.003,
    "flag_lookback_observations": 252
  },
  "costs": {
    "status": "ASSUMPTION_REQUIRES_VERIFICATION_AGAINST_CURRENT_BROKER_AND_EXCHANGE_SCHEDULES",
    "basis": "NSE equity delivery, discount broker, per side, basis points of traded value",
    "buy_bps": {"brokerage": 3.0, "stt": 10.0, "exchange_transaction": 0.3, "sebi_fee": 0.01, "stamp_duty": 1.5, "gst": 0.6, "slippage_and_impact": 10.0},
    "sell_bps": {"brokerage": 3.0, "stt": 10.0, "exchange_transaction": 0.3, "sebi_fee": 0.01, "gst": 0.6, "slippage_and_impact": 10.0},
    "excluded": ["fixed per-scrip DP charge on sale", "market impact beyond the turnover filter"]
  },
  "evaluation": {
    "top_fraction": 0.1,
    "calibration": "PLATT_FIT_ON_VALIDATION_PARTITION",
    "calibration_bins": 10,
    "trial_budget_per_horizon": 20
  },
  "models": {
    "heuristic_momentum": {"feature": "momentum_126", "fits_parameters": false},
    "logistic": {"C": 0.1, "max_iter": 300},
    "lightgbm": {
      "objective": "binary", "learning_rate": 0.05, "num_leaves": 31, "min_child_samples": 500,
      "feature_fraction": 0.8, "bagging_fraction": 0.8, "bagging_freq": 1, "lambda_l2": 1.0,
      "n_estimators": 600, "early_stopping_rounds": 50, "num_threads": 8
    }
  },
  "exploratory_models": ["heuristic_momentum", "logistic"],
  "training_models": ["heuristic_momentum", "logistic", "lightgbm"],
  "ranking_model": {"training": "lightgbm", "exploratory": "logistic"},
  "seed": 7
}
