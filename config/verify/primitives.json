{
  "contract": "stock-gplm.verify-primitives.v1",
  "source": "Owner requirement 2026-11-15: the 340-strategy library decomposes into the '118 unique primitives' list in 11 engine modules (the tables list 124 rows; every row is kept). Each row maps to DSL expressions evaluated on every timeframe, or names what is missing.",
  "status_rules": {
    "expr": "each expression must evaluate, be finite somewhere and be causal on every applicable timeframe (1m, 5m, 15m, 30m, 60m, 4h, 1d, 1w); intraday-only expressions run on every intraday timeframe",
    "verified_by": "name of the indicator check in the indicator section that compares it with an independent reference",
    "composed": "true when no named primitive exists and the calculation is expressed from other primitives",
    "approximation": "documented difference from the named method",
    "missing.kind": "NOT_IMPLEMENTED (OHLCV-computable, absent: FAIL) | DATA (needs data not held locally: WARN) | DEFERRED (owner deferred F&O/options/index-relative: WARN)"
  },
  "rows": [
    {"module": "1 Moving averages", "name": "SMA(series, n)", "exprs": ["sma(close, 20)"], "verified_by": "SMA(20)"},
    {"module": "1 Moving averages", "name": "EMA(series, n)", "exprs": ["ema(close, 12)"], "verified_by": "EMA(12)"},
    {"module": "1 Moving averages", "name": "WMA(series, n)", "exprs": ["wma(close, 10)"], "verified_by": "WMA(10)"},
    {"module": "1 Moving averages", "name": "HMA(series, n)", "exprs": ["hma(close, 21)"], "verified_by": "HMA(21)"},
    {"module": "1 Moving averages", "name": "VWMA(series, n)", "exprs": ["vwma(close, 20)"], "verified_by": "VWMA(20)"},
    {"module": "1 Moving averages", "name": "KAMA(series, n, fast, slow)", "exprs": ["kama(close, 10, 2, 30)"]},
    {"module": "1 Moving averages", "name": "McGinley_Dynamic(series, n)", "exprs": ["mcginley(close, 14)"]},
    {"module": "1 Moving averages", "name": "VWAP (intraday session)", "exprs": ["vwap"], "intraday": true},
    {"module": "1 Moving averages", "name": "AVWAP(anchor)", "exprs": ["anchored_vwap(close > highest(high, 20)[1])"],
     "missing": [{"what": "anchor at a quarterly-result date", "kind": "DATA", "reason": "no dated corporate-results calendar is held locally"}]},
    {"module": "1 Moving averages", "name": "Rolling_VWAP(n)", "exprs": ["rvwap(5)"]},
    {"module": "1 Moving averages", "name": "Kalman_Filter (estimate, velocity)", "exprs": ["kalman(close)", "kalman(close) - kalman(close)[1]"]},

    {"module": "2 Trend", "name": "ADX(n)", "exprs": ["adx(14)"], "verified_by": "ADX(14)"},
    {"module": "2 Trend", "name": "+DI(n) / -DI(n)", "exprs": ["plus_di(14)", "minus_di(14)"], "verified_by": "+DI(14)"},
    {"module": "2 Trend", "name": "Supertrend(atr_n, mult)", "exprs": ["supertrend(10, 3)", "supertrend_dir(10, 3)"], "verified_by": "Supertrend(10,3)"},
    {"module": "2 Trend", "name": "PSAR(step, max)", "exprs": ["psar(0.02, 0.2)"]},
    {"module": "2 Trend", "name": "Ichimoku (Tenkan, Kijun, Span A/B, Chikou)", "exprs": ["midpoint(9)", "midpoint(26)", "senkou_a(9, 26, 26)", "senkou_b(52, 26)", "close[26]"],
     "approximation": "Chikou is used causally as close vs close[26]; the plotted Chikou is shifted into the past by design"},
    {"module": "2 Trend", "name": "Aroon(n) up/down/oscillator", "exprs": ["aroon_up(25)", "aroon_down(25)", "aroon_up(25) - aroon_down(25)"]},
    {"module": "2 Trend", "name": "Vortex(n) VI+/VI-", "exprs": ["vi_plus(14)", "vi_minus(14)"]},
    {"module": "2 Trend", "name": "GMMA (3..15 vs 30..60 EMAs)", "composed": true,
     "exprs": ["min(ema(close, 3), ema(close, 5), ema(close, 8), ema(close, 10), ema(close, 12), ema(close, 15))", "max(ema(close, 30), ema(close, 35), ema(close, 40), ema(close, 45), ema(close, 50), ema(close, 60))"]},
    {"module": "2 Trend", "name": "Heikin_Ashi OHLC", "exprs": ["ha_open", "ha_high", "ha_low", "ha_close"]},
    {"module": "2 Trend", "name": "Chandelier_Exit(n, mult)", "composed": true, "exprs": ["highest(high, 22) - 3 * atr(22)"]},
    {"module": "2 Trend", "name": "VStop(n, mult)", "exprs": ["vstop(20, 2)"]},
    {"module": "2 Trend", "name": "LinReg_Line(n) & LinReg_Slope(n)", "exprs": ["linreg(close, 20)", "slope(close, 20)"], "verified_by": "LinReg slope(20)"},
    {"module": "2 Trend", "name": "Quadratic_Curve_Fit(n)",
     "exprs": ["quad_a(close, 60)", "quad_b(close, 60)", "quad_c(close, 60)", "quad_fit(close, 60)"],
     "verified_by": "Quadratic fit(60)"},

    {"module": "3 Momentum", "name": "RSI(series, n)", "exprs": ["rsi(close, 14)"], "verified_by": "RSI(14)"},
    {"module": "3 Momentum", "name": "MACD line/signal/hist", "exprs": ["macd(close, 12, 26)", "macd_signal(close, 12, 26, 9)", "macd_hist(close, 12, 26, 9)"], "verified_by": "MACD line(12,26)"},
    {"module": "3 Momentum", "name": "PPO(fast, slow, sig)", "exprs": ["ppo(close, 12, 26)", "ema(ppo(close, 12, 26), 9)"]},
    {"module": "3 Momentum", "name": "ROC(series, n)", "exprs": ["roc(close, 10)"], "verified_by": "ROC(10)"},
    {"module": "3 Momentum", "name": "Coppock_Curve", "composed": true, "exprs": ["wma(roc(close, 14) + roc(close, 11), 10)"]},
    {"module": "3 Momentum", "name": "TSI(r, s, sig)", "exprs": ["tsi(close, 25, 13)", "ema(tsi(close, 25, 13), 7)"]},
    {"module": "3 Momentum", "name": "KST", "exprs": ["kst", "sma(kst, 9)"]},
    {"module": "3 Momentum", "name": "TRIX(n, sig)", "exprs": ["trix(15)", "ema(trix(15), 9)"]},
    {"module": "3 Momentum", "name": "CMO(n)", "exprs": ["cmo(14)"]},
    {"module": "3 Momentum", "name": "STC(cycle, fast, slow)", "exprs": ["stc(23, 50, 10)"]},
    {"module": "3 Momentum", "name": "RVI_Vigor(n, sig)", "exprs": ["rvi(10)", "rvi_signal(10)"]},
    {"module": "3 Momentum", "name": "BOP(n)", "composed": true, "exprs": ["sma((close - open) / (high - low), 14)"]},
    {"module": "3 Momentum", "name": "DPO(n)", "exprs": ["dpo(20)"], "approximation": "causal DPO (close[n/2+1] - SMA); the classic centred DPO reads the future"},
    {"module": "3 Momentum", "name": "Stochastic %K/%D", "exprs": ["stoch_k(14, 3)", "stoch_d(14, 3, 3)"], "verified_by": "Stoch %K(14,3)"},
    {"module": "3 Momentum", "name": "StochRSI(rsi_n, stoch_n, k, d)", "exprs": ["stochrsi_k(14, 14, 3)", "stochrsi_d(14, 14, 3, 3)"]},
    {"module": "3 Momentum", "name": "Williams_R(n)", "exprs": ["willr(14)"], "verified_by": "Williams %R(14)"},
    {"module": "3 Momentum", "name": "CCI(n)", "exprs": ["cci(20)"], "verified_by": "CCI(20)"},
    {"module": "3 Momentum", "name": "Ultimate_Oscillator(s, m, l)", "exprs": ["uo(7, 14, 28)"]},
    {"module": "3 Momentum", "name": "DeMarker(n)", "exprs": ["demarker(14)"]},
    {"module": "3 Momentum", "name": "Awesome_Oscillator", "exprs": ["ao"]},
    {"module": "3 Momentum", "name": "Fisher_Transform(n) & trigger", "exprs": ["fisher(9)", "fisher(9)[1]"]},
    {"module": "3 Momentum", "name": "IFTRSI(n)", "exprs": ["ift_rsi(14)"]},
    {"module": "3 Momentum", "name": "WaveTrend WT1/WT2", "exprs": ["wt1(10, 21)", "wt2(10, 21)"]},
    {"module": "3 Momentum", "name": "Laguerre_RSI(gamma) & COG(n)", "exprs": ["laguerre_rsi(0.5)", "cog(10)"]},
    {"module": "3 Momentum", "name": "Qstick(n) & PGO(n)", "composed": true, "exprs": ["sma(close - open, 14)", "(close - sma(close, 14)) / atr(14)"]},

    {"module": "4 Volatility", "name": "ATR(n) & True_Range", "exprs": ["atr(14)", "tr"], "verified_by": "ATR(14)"},
    {"module": "4 Volatility", "name": "Bollinger_Bands upper/lower/width/%B", "exprs": ["bb_upper(close, 20, 2)", "bb_lower(close, 20, 2)", "bb_width(close, 20, 2)", "pctb(close, 20, 2)"], "verified_by": "Bollinger %B(20,2)"},
    {"module": "4 Volatility", "name": "Keltner_Channel(n, mult)", "exprs": ["kc_upper(20, 1.5)", "kc_lower(20, 1.5)"]},
    {"module": "4 Volatility", "name": "Donchian_Channel(n) & width", "exprs": ["highest(high, 20)", "lowest(low, 20)", "(highest(high, 20) - lowest(low, 20)) / lowest(low, 20)"], "verified_by": "Highest(high,20)"},
    {"module": "4 Volatility", "name": "Envelope_Channel(n, pct)", "composed": true, "exprs": ["sma(close, 20) * 1.05", "sma(close, 20) * 0.95"]},
    {"module": "4 Volatility", "name": "Starc_Bands", "composed": true, "exprs": ["sma(close, 6) + 2 * atr(15)", "sma(close, 6) - 2 * atr(15)"]},
    {"module": "4 Volatility", "name": "Fractal_Chaos_Bands", "exprs": ["swing_high(2)", "swing_low(2)"], "approximation": "5-bar Williams fractal = swing pivot with 2 bars each side, available only once confirmed (2 bars later)"},
    {"module": "4 Volatility", "name": "Choppiness_Index(n)", "exprs": ["chop(14)"]},
    {"module": "4 Volatility", "name": "Chaikin_Volatility", "exprs": ["chaikin_vol(10, 10)"]},
    {"module": "4 Volatility", "name": "Historical_Volatility(n) & HVR", "exprs": ["hv(20)", "hv(6) / hv(100)"]},
    {"module": "4 Volatility", "name": "Realized_Volatility(n) & Bipower_Var", "composed": true, "exprs": ["sqrt(sum(ret * ret, 20))", "1.5707963 * sum(abs(ret) * abs(ret[1]), 20)"]},
    {"module": "4 Volatility", "name": "Parkinson_Vol(n)", "exprs": ["parkinson(10)"]},
    {"module": "4 Volatility", "name": "Yang_Zhang_Vol(n)", "composed": true,
     "exprs": ["sqrt(stdev(log(open / close[1]), 20) * stdev(log(open / close[1]), 20) + 0.0784 * stdev(log(close / open), 20) * stdev(log(close / open), 20) + 0.9216 * sma(log(high / close) * log(high / open) + log(low / close) * log(low / open), 20))"],
     "approximation": "composed with population variances and k = 0.34 / (1.34 + 21/19) ~ 0.0784 for n = 20; no named primitive"},
    {"module": "4 Volatility", "name": "Mass_Index(ema_n, sum_n)", "exprs": ["mass_index(9, 25)"]},
    {"module": "4 Volatility", "name": "Ulcer_Index(n)", "exprs": ["ulcer(14)"]},
    {"module": "4 Volatility", "name": "Dorsey_RVI(n)", "composed": true,
     "exprs": ["100 * ema(iff(close > close[1], stdev(close, 10), 0), 14) / (ema(iff(close > close[1], stdev(close, 10), 0), 14) + ema(iff(close < close[1], stdev(close, 10), 0), 14))"]},
    {"module": "4 Volatility", "name": "GAPO(n)", "exprs": ["gapo(14)"]},
    {"module": "4 Volatility", "name": "Downside_SemiVar(n)", "composed": true, "exprs": ["sum(min(ret, 0) * min(ret, 0), 20) / 20"]},

    {"module": "5 Volume", "name": "OBV", "exprs": ["obv"], "verified_by": "OBV"},
    {"module": "5 Volume", "name": "CMF(n)", "exprs": ["cmf(20)"], "verified_by": "CMF(20)"},
    {"module": "5 Volume", "name": "AD_Line & Chaikin_Osc", "exprs": ["ad", "ema(ad, 3) - ema(ad, 10)"]},
    {"module": "5 Volume", "name": "MFI(n)", "exprs": ["mfi(14)"], "verified_by": "MFI(14)"},
    {"module": "5 Volume", "name": "Volume_Profile POC/VAH/VAL/LVN", "exprs": ["vp_poc(60)", "vp_vah(30)", "vp_val(30)", "vp_density(60)"], "approximation": "LVN = low vp_density of the close's price bin"},
    {"module": "5 Volume", "name": "VROC(n)", "composed": true, "exprs": ["roc(volume, 14)"]},
    {"module": "5 Volume", "name": "KVO(fast, slow, sig)", "exprs": ["kvo(34, 55)", "kvo_signal(34, 55, 13)"]},
    {"module": "5 Volume", "name": "EOM(n)", "exprs": ["eom(14)"]},
    {"module": "5 Volume", "name": "Force_Index(n)", "exprs": ["force(13)"]},
    {"module": "5 Volume", "name": "NVI & PVI", "exprs": ["nvi", "pvi"]},
    {"module": "5 Volume", "name": "TMF(n) Twiggs money flow", "composed": true,
     "exprs": ["rma(((close - min(low, close[1])) - (max(high, close[1]) - close)) / (max(high, close[1]) - min(low, close[1])) * volume, 21) / rma(volume, 21)"]},
    {"module": "5 Volume", "name": "VW_MACD(fast, slow, sig)", "composed": true, "exprs": ["vwma(close, 12) - vwma(close, 26)", "ema(vwma(close, 12) - vwma(close, 26), 9)"]},
    {"module": "5 Volume", "name": "Up_Down_Vol_Ratio(n)", "composed": true, "exprs": ["sum(iff(close > open, volume, 0), 50) / sum(iff(close < open, volume, 0), 50)"]},
    {"module": "5 Volume", "name": "PVT", "exprs": ["pvt"]},
    {"module": "5 Volume", "name": "Intraday_Intensity(n)", "composed": true, "exprs": ["sum((2 * close - high - low) / (high - low) * volume, 21)"]},
    {"module": "5 Volume", "name": "Weis_Wave_Volume",
     "exprs": ["weis_wave_direction(0.02)", "weis_wave_volume(0.02)", "weis_prev_wave_volume(0.02)"],
     "verified_by": "Weis wave volume(2%)"},
    {"module": "5 Volume", "name": "Delivery_Pct & Delivery_Vol", "exprs": [],
     "missing": [{"what": "NSE deliverable quantity", "kind": "DATA", "reason": "bhavcopy delivery data is not held locally"}]},
    {"module": "5 Volume", "name": "Float_Turnover & RVOL_Slot", "exprs": ["slot_rvol(20)"], "intraday": true,
     "missing": [{"what": "free-float shares for Float_Turnover", "kind": "DATA", "reason": "no point-in-time free-float data"}]},

    {"module": "6 Pivots & session", "name": "Floor_Pivots (P, R1..R3, S1..S3)", "composed": true,
     "exprs": ["(prev_day_high + prev_day_low + prev_day_close) / 3", "2 * (prev_day_high + prev_day_low + prev_day_close) / 3 - prev_day_low", "(prev_day_high + prev_day_low + prev_day_close) / 3 - (prev_day_high - prev_day_low)"]},
    {"module": "6 Pivots & session", "name": "CPR (Pivot, BC, TC, width)", "composed": true,
     "exprs": ["(prev_day_high + prev_day_low) / 2", "2 * (prev_day_high + prev_day_low + prev_day_close) / 3 - (prev_day_high + prev_day_low) / 2"],
     "missing": [{"what": "Virgin-CPR tracking (untested CPR of prior sessions)", "kind": "NOT_IMPLEMENTED", "reason": "no state primitive for untouched zones"}]},
    {"module": "6 Pivots & session", "name": "Camarilla_Pivots H1..H5 / L1..L5", "composed": true, "exprs": ["prev_day_close + 1.1 * (prev_day_high - prev_day_low) / 2", "prev_day_close - 1.1 * (prev_day_high - prev_day_low) / 4"]},
    {"module": "6 Pivots & session", "name": "Opening_Range(mins) & midday window", "exprs": ["or_high(15)", "or_low(30)", "window_high(135, 240)"], "intraday": true,
     "timeframes": ["1m", "5m", "15m"], "timeframe_reason": "15/30-minute opening ranges require source bars no coarser than 15m; larger aggregate bars cannot be decomposed"},
    {"module": "6 Pivots & session", "name": "SMI & Overnight/Intraday returns", "composed": true, "exprs": ["gap", "close / open - 1"],
     "missing": [{"what": "Smart Money Index (cumulative -first-30-min + last-hour return)", "kind": "NOT_IMPLEMENTED", "reason": "needs a cumulative-sum primitive; catalogue C6-044 is blocked"}]},

    {"module": "7 Structure", "name": "Swing_High_Low / ZigZag", "exprs": ["swing_high(3)", "swing_low(3)", "swing_high_age(3)"]},
    {"module": "7 Structure", "name": "Candle_Anatomy (body, wicks, range, CLV)", "exprs": ["body", "upper_wick", "lower_wick", "range", "(close - low) / (high - low)"]},
    {"module": "7 Structure", "name": "Inside_Bar / NR_Detector", "composed": true, "exprs": ["high < high[1] and low > low[1]", "(high - low) == lowest(high - low, 7)"]},
    {"module": "7 Structure", "name": "FVG_Detector", "composed": true, "exprs": ["low > high[2]"],
     "missing": [{"what": "mitigation tracking of open gaps", "kind": "NOT_IMPLEMENTED", "reason": "no state primitive for unmitigated zones"}]},
    {"module": "7 Structure", "name": "Order_Block_Detector", "exprs": [],
     "missing": [{"what": "last opposing candle before a BOS impulse", "kind": "NOT_IMPLEMENTED", "reason": "no DSL primitive"}]},
    {"module": "7 Structure", "name": "VCP_Contraction_Engine", "exprs": [],
     "missing": [{"what": "sequential swing pullback depth tracker", "kind": "NOT_IMPLEMENTED", "reason": "no DSL primitive"}]},
    {"module": "7 Structure", "name": "Chart_Pattern_Geometry (cup, H&S, triangles, wedges, flags, box)", "exprs": ["swing_high(3) < swing_high(3, 2) and swing_low(3) > swing_low(3, 2)"],
     "approximation": "pattern families are approximated from confirmed swing pivots",
     "missing": [{"what": "dedicated pattern geometry (cup depth, necklines, trendline fits)", "kind": "NOT_IMPLEMENTED", "reason": "only swing-pivot approximations exist"}]},
    {"module": "7 Structure", "name": "Fibonacci_Engine (retracements, extensions)", "composed": true,
     "exprs": ["swing_high(3) - 0.618 * (swing_high(3) - swing_low(3))", "swing_low(3) + 1.272 * (swing_high(3) - swing_low(3))"],
     "missing": [{"what": "harmonic pattern geometry (Gartley, Bat, Three Drives)", "kind": "NOT_IMPLEMENTED", "reason": "catalogue harmonics are blocked"}]},
    {"module": "7 Structure", "name": "Trendline_Pitchfork_Fit", "exprs": [],
     "missing": [{"what": "diagonal line through swing points; Andrews pitchfork", "kind": "NOT_IMPLEMENTED", "reason": "no DSL primitive"}]},
    {"module": "7 Structure", "name": "Point_And_Figure_Matrix", "exprs": [],
     "missing": [{"what": "box/reversal X-O column generator", "kind": "NOT_IMPLEMENTED", "reason": "no DSL primitive"}]},
    {"module": "7 Structure", "name": "DTW_Distance(s1, s2)", "exprs": [],
     "missing": [{"what": "dynamic time warping distance", "kind": "NOT_IMPLEMENTED", "reason": "no DSL primitive"}]},

    {"module": "8 Statistics", "name": "Z_Score(series, n)", "exprs": ["zscore(close, 20)"], "verified_by": "ZScore(20)"},
    {"module": "8 Statistics", "name": "StdErr(n) & R_Squared(n)", "exprs": ["stderr(close, 20)", "r2(close, 20)"]},
    {"module": "8 Statistics", "name": "Rolling_Beta(stock, bench, n)", "exprs": ["beta(ret, bench(ret), 60)"], "needs": "BENCHMARK",
     "missing": [{"what": "official Nifty/sector index history", "kind": "DEFERRED", "reason": "index-relative work deferred by the owner; computed here against a synthetic benchmark"}]},
    {"module": "8 Statistics", "name": "ADF_Test(s1, s2)", "exprs": [],
     "missing": [{"what": "augmented Dickey-Fuller p-value", "kind": "NOT_IMPLEMENTED", "reason": "no DSL primitive; pairs trading C6-023 is blocked"}]},
    {"module": "8 Statistics", "name": "OU_Half_Life(spread, n)", "composed": true, "exprs": ["0 - log(2) / log(1 + beta(change(close, 1), close[1], 60))"]},
    {"module": "8 Statistics", "name": "Euclidean_Pair_Dist(s1, s2)", "composed": true, "needs": "PAIR",
     "exprs": ["sum((close / close[60] - ref_symbol(\"PAIRB\", close / close[60])) * (close / close[60] - ref_symbol(\"PAIRB\", close / close[60])), 60)"],
     "missing": [{"what": "a defined pair universe", "kind": "DEFERRED", "reason": "pairs/stat-arb deferred; computed here against a synthetic second symbol"}]},
    {"module": "8 Statistics", "name": "Hurst_Exponent(series, n)", "exprs": ["hurst(close, 100)"], "approximation": "variance-scaling estimator, not rescaled range (R/S)"},
    {"module": "8 Statistics", "name": "Sample_Entropy(series, n)", "exprs": ["updown_entropy(20, 2)"], "approximation": "Shannon entropy of up/down patterns, not sample entropy"},
    {"module": "8 Statistics", "name": "Autocorrelation(series, lag, n)", "exprs": ["autocorr(ret, 30, 1)"]},
    {"module": "8 Statistics", "name": "Variance_Ratio(n, k)", "composed": true, "exprs": ["stdev(roc(close, 10), 60) * stdev(roc(close, 10), 60) / (10 * stdev(ret, 60) * stdev(ret, 60))"]},
    {"module": "8 Statistics", "name": "Skewness(series, n)", "exprs": ["skew(ret, 60)"]},

    {"module": "9 Regime & ML", "name": "HMM_Regime_Posterior", "exprs": [],
     "missing": [{"what": "hidden Markov model forward filter", "kind": "NOT_IMPLEMENTED", "reason": "catalogue 311 documented as not built"}]},
    {"module": "9 Regime & ML", "name": "Online_ChangePoint_Prob", "exprs": ["cusum_up(ret, 20)"], "approximation": "one-sided CUSUM statistic, not a Bayesian online change-point posterior"},
    {"module": "9 Regime & ML", "name": "kNN_Analogue_Search", "exprs": [],
     "missing": [{"what": "nearest-neighbour analogue search", "kind": "NOT_IMPLEMENTED", "reason": "catalogue 339 documented as not built"}]},
    {"module": "9 Regime & ML", "name": "GP_Symbolic_MetaModel", "exprs": [], "method": "strategy_evolve (genetic programming) - verified in the ML section",
     "missing": [{"what": "meta-labelling classifier (catalogue 340)", "kind": "NOT_IMPLEMENTED", "reason": "documented as not built"}]},

    {"module": "10 Derivatives & RS", "name": "Mansfield_RS & JdK_RRG", "composed": true, "needs": "BENCHMARK",
     "exprs": ["(close / bench(close)) / sma(close / bench(close), 52) - 1"],
     "missing": [{"what": "official index history; JdK normalisation", "kind": "DEFERRED", "reason": "index-relative work deferred by the owner"}]},
    {"module": "10 Derivatives & RS", "name": "Cross_Sectional_Rank", "exprs": ["percentrank(roc(close, 126), 252)"],
     "approximation": "time-series percentile of the stock's own history, not a universe rank",
     "missing": [{"what": "point-in-time universe ranking", "kind": "DATA", "reason": "no point-in-time membership; the engine evaluates one lane at a time"}]},
    {"module": "10 Derivatives & RS", "name": "Futures_OI_Metrics", "exprs": [],
     "missing": [{"what": "futures prices and open interest", "kind": "DEFERRED", "reason": "F&O deferred by the owner; no local data"}]},
    {"module": "10 Derivatives & RS", "name": "Option_Chain_Analytics", "exprs": [],
     "missing": [{"what": "option chain OI/IV", "kind": "DEFERRED", "reason": "options deferred by the owner; no local data"}]},
    {"module": "10 Derivatives & RS", "name": "Amihud_Illiquidity(n)", "composed": true, "exprs": ["sma(abs(ret) / (close * volume), 20)"]},
