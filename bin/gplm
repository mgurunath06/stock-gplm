#!/usr/bin/env bash
# Stock GPLM research application (Linux/WSL launcher). Windows: windows\gplm.cmd
# Uses $GPLM_PYTHON, else this checkout's .venv, else the shared project venv.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${GPLM_PYTHON:-}"
if [[ -z "$PY" ]]; then
  for c in "$HERE/.venv/bin/python" "$HERE/../stock-gplm/.venv/bin/python"; do
    [[ -x "$c" ]] && PY="$c" && break
  done
fi
[[ -n "$PY" ]] || { echo "set GPLM_PYTHON to a Python 3.12 with numpy, pandas and scipy" >&2; exit 1; }
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m stock_gplm.app.cli "$@"
